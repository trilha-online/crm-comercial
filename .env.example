# Copie este arquivo para .env.local e preencha com os dados do Supabase DO CRM
# (Project Settings → API). O .env.local não vai para o GitHub.
#
# Use a "anon" / "publishable" key. NUNCA coloque a service_role / secret key aqui:
# tudo que começa com VITE_ fica visível no navegador.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=cole-aqui-a-anon-key
